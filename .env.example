# Copy to .env and fill in. Never commit .env.

# Public hostname Caddy will get a certificate for (DNS A record must point at this server)
DOMAIN=app.example.com

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Leave 0 until HTTPS works, then set 31536000
DJANGO_HSTS_SECONDS=0

POSTGRES_DB=sakoratill
POSTGRES_USER=sakoratill
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
